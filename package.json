{
  "name": "tao-te-ching",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A continuous bilingual reading of the Tao Te Ching",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "dev": "node scripts/serve.mjs --watch",
    "check": "node --check src/app.js && node scripts/verify-build.mjs dist",
    "test": "node --test tests/*.test.mjs"
  }
}
